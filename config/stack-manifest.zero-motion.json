{
  "schema_version": "qualia.stack.v1",
  "stack_name": "qualia-zero-motion-fixture",
  "shared_memory": {
    "name": "/qualia_zero_motion_fixture"
  },
  "control": {
    "socket": "/tmp/qualia_zero_motion_fixture.sock"
  },
  "runners": [
    { "name": "qualia-health", "stdout": "null" },
    {
      "name": "qualia-cuda-service",
      "stdout": "null",
      "env_passthrough": [
        "QUALIA_COMPUTE_SOCKET",
        "QUALIA_CUDA_SM",
        "QUALIA_CUDA_DEVICE_NAME"
      ]
    },
    {
      "name": "qualia-agent",
      "stdout": "null",
      "env_passthrough": [
        "QUALIA_WEB_PORT",
        "QUALIA_MISSION_BROKER_TOKEN",
        "QUALIA_ADMIN_TOKEN",
        "QUALIA_SESSION_STORE",
        "QUALIA_MISSION_CONTROL_JOURNAL",
        "QUALIA_TLS_DIR",
        "QUALIA_FLY_MODE",
        "QUALIA_FLY_PRIOR_PATH"
      ]
    },
    {
      "name": "qualia-explore",
      "stdout": "null",
      "env_passthrough": [
        "QUALIA_COMPUTE_SOCKET",
        "QUALIA_FLY_MODE",
        "QUALIA_FLY_PRIOR_PATH"
      ]
    },
    {
      "name": "qualia-arena-recorder",
      "stdout": "inherit",
      "env_passthrough": [
        "QUALIA_MCAP_ROOT",
        "QUALIA_ARENA_SESSION",
        "QUALIA_MCAP_DURATION_SECONDS",
        "QUALIA_MCAP_POLL_MS",
        "QUALIA_CAMERA_ENTITY",
        "QUALIA_AGENT_URL",
        "QUALIA_SESSION_STORE",
        "QUALIA_SESSION_ID"
      ]
    }
  ],
  "env": {
    "QUALIA_FLY_MODE": "prior",
    "QUALIA_FLY_PRIOR_PATH": "assets/brain/prior",
    "QUALIA_CUDA_SM": "89"
  }
}

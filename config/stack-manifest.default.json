{
  "schema_version": "qualia.stack.v1",
  "stack_name": "qualia-default",
  "shared_memory": {
    "name": "/qualia_body"
  },
  "control": {
    "socket": "/tmp/qualia_body.sock"
  },
  "runners": [
    {
      "name": "qualia-l0-superposition"
    },
    {
      "name": "qualia-l1-belief"
    },
    {
      "name": "qualia-l2-belief"
    },
    {
      "name": "qualia-l3-belief"
    },
    {
      "name": "qualia-l4-behavior"
    },
    {
      "name": "qualia-l5-behavior"
    },
    {
      "name": "qualia-l6-semantic"
    },
    {
      "name": "qualia-health",
      "stdout": "null"
    },
    {
      "name": "qualia-vision",
      "stdout": "null"
    },
    {
      "name": "qualia-agent",
      "stdout": "null",
      "env_passthrough": [
        "QUALIA_REPLICA_ID",
        "QUALIA_REPLICA_ROLE",
        "QUALIA_REPLICA_DISPLAY_NAME",
        "QUALIA_REPLICA_CAPABILITIES_JSON",
        "QUALIA_REPLICA_METADATA_JSON",
        "QUALIA_SYNC_ENDPOINT",
        "QUALIA_SYNC_PEER_POLL_MS",
        "QUALIA_SYNC_PEER_PAGE_LIMIT",
        "QUALIA_SYNC_ACCEPT_INVALID_CERTS",
        "QUALIA_LEASH_BASE_URL",
        "QUALIA_LEASH_OPERATOR_TOKEN_FILE"
      ]
    },
    {
      "name": "qualia-leash-sensors",
      "env_passthrough": [
        "QUALIA_LEASH_BASE_URL"
      ]
    },
    {
      "name": "qualia-camera",
      "env_passthrough": [
        "QUALIA_CAMERA_STREAM_URL"
      ]
    }
  ],
  "env": {
    "QUALIA_FLY_MODE": "off",
    "QUALIA_FLY_PRIOR_PATH": "",
    "QUALIA_FLY_COUPLING_SCALE": "1.0",
    "QUALIA_LEASH_BASE_URL": "http://127.0.0.1:8000",
    "QUALIA_CAMERA_STREAM_URL": "http://127.0.0.1:8000/camera/stream.mjpg"
  }
}

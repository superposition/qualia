/target
*.cubin
*.ptx
.DS_Store
/artifacts
/.qualia_tls
/dimos
/drone-dataset

# Secrets: no environment file may be committed. Examples are the only
# env-shaped files that belong in the tree.
**/*.env
!**/*.env.example
deploy/**/camera-stream.env

# Python bytecode from the figure scripts
__pycache__/
*.pyc
# egui_kittest writes these beside a snapshot when UPDATE_SNAPSHOTS=1 runs.
apps/qualia-console/tests/snapshots/*.old.png
apps/qualia-console/tests/snapshots/*.diff.png

# The console example renders a scratch snapshot relative to the invocation cwd; never a repo root file.
/tests/
